        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "tags": [
          "Audit"
        ],
        "operationId": "ListAuditEvents",
        "summary": "List audit events",
        "description": "Every resolve and every write of a secret or grant, newest first, a page at a time: while `nextToken` is not null, pass it for the next page. No event holds a value.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$",
              "description": "Only resolves for this agent."
            },
            "required": false,
            "description": "Only resolves for this agent.",
            "name": "agent",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "ResolveSecrets",
                "PutSecret",
                "DeleteSecret",
                "CreateGrant",
                "DeleteGrant"
              ],
              "description": "Only this operation."
            },
            "required": false,
            "description": "Only this operation.",
            "name": "action",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100,
              "description": "The most to answer. Default: 100."
            },
            "required": false,
            "description": "The most to answer. Default: 100.",
            "name": "maxResults",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 40,
              "description": "The `nextToken` a page answered, for the page after it."
            },
            "required": false,
            "description": "The `nextToken` a page answered, for the page after it.",
            "name": "nextToken",
            "in": "query"
          }
        ],
        "responses": {
