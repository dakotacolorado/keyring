                  "$ref": "#/components/schemas/Secret"
                }
              }
            }
          },
          "400": {
            "description": "ValidationException: The request failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UnauthorizedException: No bearer token or session, or it is wrong, revoked or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "ResourceNotFoundException: No secret has that name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "tags": [
          "Secrets"
        ],
        "operationId": "DeleteSecret",
        "summary": "Delete a secret",
        "description": "Deletes a secret, its value and every grant of it.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "description": "The secret's name: letters, digits, `_`, `.` and `-`, at most 128.",
              "example": "CLAUDE_CODE_OAUTH_TOKEN-main"
            },
